{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle WebLogic Server APIs Oracle WebLogic Server Deployment Application Deployments Upload API",
    "version": "14.1.1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Upload",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Oracle WebLogic Server APIs Upload an application archive",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}:{port}/management/weblogic/latest/domainRuntime/deploymentManager/upload",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Uploads an application archive (EAR, WAR, JAR) or deployment plan to the administration server upload directory for subsequent deployment."
        }
      ]
    }
  ],
  "bundled": true
}